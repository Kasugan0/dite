# DITE Configuration File Example
# Use this content for ~/.config/dite/config.yaml

# API Configuration (required)
api:
  base_url: https://api.example.com/v1
  api_key: your-api-key
  connect_timeout_sec: 5.0           # HTTP connect timeout
  read_timeout_sec: 60.0             # HTTP read timeout
  write_timeout_sec: 60.0            # HTTP write timeout
  pool_timeout_sec: 5.0              # HTTP pool-acquire timeout
  max_retries: 2                     # SDK transport retry count
  max_connections: 32                # Shared HTTP connection pool upper bound
  max_keepalive_connections: 16      # Shared keep-alive pool upper bound
  keepalive_expiry_sec: 5.0          # Keep-alive expiry

# Model Configuration (Qwen3 series recommended)
models:
  embedding: Qwen/Qwen3-Embedding-8B   # Embedding model
  vlm: Qwen/Qwen3-VL-32B-Instruct      # Vision-Language model
  llm: Qwen/Qwen3-32B                  # Text generation model

# Request Profiles (task-specific)
request_profiles:
  cluster_naming:
    max_tokens: 50
    reasoning_mode: "off"              # default / off / on
    thinking_budget: null

# Clustering Parameters
clustering:
  min_cluster_size: 3                  # Minimum cluster size
  min_samples: 2                       # Minimum samples for core points
  cluster_selection_epsilon: 0.25      # Cluster selection threshold
  cluster_selection_method: eom        # eom=larger clusters, leaf=fine-grained
  small_cluster_merge_enabled: true    # Merge very small clusters into a close larger cluster
  small_cluster_merge_max_size: 4      # Maximum cluster size eligible for merge
  small_cluster_merge_cosine_threshold: 0.92  # Minimum centroid cosine similarity

# Processing Parameters
processing:
  text_truncate_limit: 4000            # Smart excerpt limit used for downstream processing
  vlm_fallback_threshold: 100          # Final-output usability threshold used by pdf-check smoke checks
  docling_pdf_timeout_sec: 60          # Max seconds per Docling PDF extraction
  docling_device: auto                 # auto / cpu / cuda / cuda:N / mps
  extract_workers: 4                   # Max concurrent file extraction workers
  docling_pdf_workers: 1               # Max concurrent Docling PDF subprocesses
  cluster_naming_workers: 2            # Max concurrent cluster naming requests
  vlm_api_workers: 8                   # Max concurrent VLM requests across files/pages
  vlm_pages_per_document: 4            # Max concurrent VLM page requests within one PDF

# Optional feature enrichment for clustering V2
feature_extraction:
  analysis_enabled: false              # Enable analyzer-based feature enrichment
  analysis_max_content_length: 4000    # Prompt truncation length for analyzer input
  analysis_max_retries: 2              # Analyzer retry count

# Candidate edge / component generation
candidate_generation:
  filename_token_overlap_threshold: 0.8
  content_similarity_threshold: 0.92
  component_min_edge_score: 0.9

# Topic clustering controls
topic_clustering:
  mode: density                        # density / graph
  reducer: none                        # none / pca
  pca_components: null                 # Used only when reducer = pca
  allow_single_cluster: false

# Optional LLM-assisted boundary adjudication
cluster_adjudication:
  enable_llm_judging: false
  edge_merge_threshold: 0.92
  request_score_threshold: 0.85

# Cluster representation mode
cluster_representation:
  mode: deterministic                  # deterministic / llm_enhanced

# Notes:
# - pdf-check is a smoke check for final output usability, not a full-document completeness audit.
# - When PDF fallback uses VLM, only the first 10 pages are sampled.
# - That 10-page sampling limit is fixed in the current design and is not configurable here.

# Internationalization
i18n:
  locale: en                           # en (default) or zh-CN

# Cache Configuration (optional)
# cache:
#   enabled: true
#   directory: ~/.cache/dite
#   max_size_gb: 5

# Supported File Formats (optional)
# formats:
#   documents: [.pdf, .docx, .doc, .pptx, .ppt, .xlsx, .xls, .md, .markdown, .txt, .rtf]
#   images: [.jpg, .jpeg, .png, .webp, .gif]
